{
  "name": "siftarr",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified self-hosted ARR library review tool.",
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,server\" -c \"blue,green\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
